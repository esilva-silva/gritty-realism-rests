<header class="gritty-panel-header">
    <i class="fa-solid fa-moon" inert></i>
    <h3>{{localize "GRITTY.Panel.Title"}}</h3>
    <span class="gritty-panel-index">{{localize "GRITTY.Rest.RestIndex"}} {{restIndex}}</span>
    <button type="button" class="gritty-header-button" data-action="takeRest"
            data-tooltip="{{localize 'GRITTY.Rest.Tooltip'}}"
            aria-label="{{localize 'GRITTY.Rest.Label'}}">
        <i class="fa-solid fa-bed" inert></i>
    </button>
    {{#if mayAdjust}}
    <button type="button" class="gritty-header-button" data-action="addEntry"
            data-tooltip="{{localize 'GRITTY.Entry.AddTooltip'}}"
            aria-label="{{localize 'GRITTY.Entry.Add'}}">
        <i class="fa-solid fa-plus" inert></i>
    </button>
    {{/if}}
    {{#if isGM}}
    <button type="button" class="gritty-header-button" data-action="openLedger"
            data-tooltip="{{localize 'GRITTY.Panel.OpenLedger'}}"
            aria-label="{{localize 'GRITTY.Panel.OpenLedger'}}">
        <i class="fa-solid fa-scroll" inert></i>
    </button>
    {{/if}}
</header>

<div class="gritty-panel-body">

    {{#if isEmpty}}
    <p class="gritty-empty">{{localize "GRITTY.Panel.Empty"}}</p>
    {{/if}}

    {{#if hasReady}}
    <section class="gritty-section">
        <h4>{{localize "GRITTY.Panel.Ready"}}</h4>
        <ul class="gritty-list gritty-recover">
            {{#each ready}}
            <li data-entry-ids="{{this.id}}">
                {{#if this.img}}<img src="{{this.img}}" alt="" width="18" height="18">{{/if}}
                <span class="gritty-label" {{#if this.description}}data-tooltip="{{this.description}}"{{/if}}>{{this.label}}</span>
                {{#if this.showAmount}}<span class="gritty-amount">&times;{{this.amount}}</span>{{/if}}
                <span class="gritty-group" data-group="{{this.group}}">{{this.groupLabel}}</span>
            </li>
            {{/each}}
        </ul>
    </section>
    {{/if}}

    {{#if hasRecovering}}
    <section class="gritty-section">
        <h4>{{localize "GRITTY.Panel.Recovering"}}</h4>
        <ul class="gritty-list gritty-progress">
            {{#each recovering}}
            <li data-entry-ids="{{this.id}}">
                {{#if this.img}}<img src="{{this.img}}" alt="" width="18" height="18">{{/if}}
                <span class="gritty-label" {{#if this.description}}data-tooltip="{{this.description}}"{{/if}}>{{this.label}}</span>
                {{#if this.showAmount}}<span class="gritty-amount">&times;{{this.amount}}</span>{{/if}}
                <span class="gritty-group" data-group="{{this.group}}">{{this.groupLabel}}</span>
                <span class="gritty-remaining">{{this.rests}}</span>
                {{#if @root.mayAdjust}}
                <span class="gritty-row-controls">
                    <button type="button" data-gritty-adjust="sooner"
                            data-tooltip="{{localize 'GRITTY.Panel.Sooner'}}"
                            aria-label="{{localize 'GRITTY.Panel.Sooner'}}">
                        <i class="fa-solid fa-minus" inert></i>
                    </button>
                    <button type="button" data-gritty-adjust="later"
                            data-tooltip="{{localize 'GRITTY.Panel.Later'}}"
                            aria-label="{{localize 'GRITTY.Panel.Later'}}">
                        <i class="fa-solid fa-plus" inert></i>
                    </button>
                    <button type="button" data-gritty-adjust="recover"
                            data-tooltip="{{localize 'GRITTY.Ledger.RecoverNow'}}"
                            aria-label="{{localize 'GRITTY.Ledger.RecoverNow'}}">
                        <i class="fa-solid fa-rotate-left" inert></i>
                    </button>
                    <button type="button" data-gritty-adjust="delete"
                            data-tooltip="{{localize 'GRITTY.Ledger.Delete'}}"
                            aria-label="{{localize 'GRITTY.Ledger.Delete'}}">
                        <i class="fa-solid fa-trash" inert></i>
                    </button>
                </span>
                {{/if}}
            </li>
            {{/each}}
        </ul>
    </section>
    {{/if}}

    {{#if debtTotal}}
    <section class="gritty-section gritty-debt">
        <h4>{{localize "GRITTY.Panel.Debt"}}</h4>
        <ul class="gritty-list">
            {{#each debt}}
            <li>
                <i class="fa-solid fa-droplet" inert></i>
                <span class="gritty-label">{{localize "GRITTY.Panel.DebtAmount" remaining=this.remaining count=this.rests}}</span>
            </li>
            {{/each}}
        </ul>
    </section>
    {{/if}}

</div>
